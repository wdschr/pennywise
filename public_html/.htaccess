# Pennywise - public_html security rules

# Never list directory contents.
Options -Indexes -MultiViews
DirectoryIndex index.php

# Block direct access to files that should never be served.
<FilesMatch "(\.sql|\.log|\.md|\.lock|composer\.(json|lock)|\.env)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Root requests should land on the login/dashboard router.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /index.php [L]
</IfModule>

# Sensible defaults; PHP itself also sets these per-request in bootstrap.php.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>
